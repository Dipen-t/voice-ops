{
  "name": "voiceops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && docker compose --env-file .env.admin --profile runtime up -d --build --wait api",
    "dev:api": "node --env-file=.env --import tsx apps/api/src/server.ts",
    "investigator:setup": "node --import tsx scripts/setup-investigator.ts",
    "investigator:start": "npm run build && docker compose --env-file .env.admin --profile investigator up -d --build --wait investigator",
    "mcp:build": "npm run build && docker compose --env-file .env.admin --profile tools build mcp",
    "mcp:serve": "docker compose --env-file .env.admin --profile tools run --rm --no-deps -T mcp",
    "mcp:smoke": "node --env-file=.env --import tsx scripts/mcp-smoke.ts",
    "test:mcp": "node --env-file=.env ./node_modules/vitest/vitest.mjs run apps/mcp-server/tests/protocol.integration.test.ts",
    "rag:model": "node --import tsx scripts/prepare-embedding-model.ts",
    "rag:worker": "node --env-file=.env.ingest dist/apps/worker/src/main.js",
    "rag:ingest": "node --env-file=.env.ingest --import tsx scripts/enqueue-runbooks.ts",
    "rag:search": "node --env-file=.env --import tsx scripts/search-runbooks.ts",
    "rag:evaluate": "node --env-file=.env --import tsx scripts/evaluate-rag.ts",
    "test:rag": "node --env-file=.env.ingest --env-file=.env ./node_modules/vitest/vitest.mjs run packages/rag/tests/retrieval.integration.test.ts && node --env-file=.env.ingest ./node_modules/vitest/vitest.mjs run packages/rag/tests/replacement.integration.test.ts",
    "rag:verify-citations": "node --import tsx scripts/verify-runbook-anchors.ts",
    "infra:up": "docker compose --env-file .env.admin up -d --wait",
    "infra:stop": "docker compose --env-file .env.admin --profile runtime stop",
    "db:migrate": "node --env-file=.env.admin --import tsx packages/db/src/migrate.ts",
    "db:setup": "node --import tsx scripts/setup-isolation.ts",
    "data:inspect": "node --import tsx scripts/inspect-rcaeval.ts",
    "data:audit-sources": "node --import tsx scripts/audit-sources.ts",
    "data:select": "node --import tsx scripts/select-cases.ts",
    "data:download": "node --import tsx scripts/download-cases.ts",
    "data:import": "node --env-file=.env.admin --import tsx scripts/import-incidents.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@voiceops/web",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "node --env-file=.env.admin --env-file=.env ./node_modules/vitest/vitest.mjs run apps/api/tests/health.integration.test.ts packages/db/tests/isolation.integration.test.ts",
    "test:data": "node --env-file=.env.admin --env-file=.env ./node_modules/vitest/vitest.mjs run scripts/tests/data.integration.test.ts",
    "build": "tsc -p tsconfig.build.json && npm run build --workspace=@voiceops/web",
    "investigator:smoke": "node --env-file=.env --env-file=.env.model --import tsx scripts/investigator-smoke.ts",
    "test:investigator": "node --env-file=.env ./node_modules/vitest/vitest.mjs run apps/api/tests/investigator.integration.test.ts",
    "investigator:http-smoke": "node --env-file=.env.model --import tsx scripts/investigator-http-smoke.ts",
    "documents:setup": "npm run build && node --env-file=.env.ingest --import tsx scripts/setup-document-demo.ts",
    "documents:smoke": "node --env-file=.env.model --import tsx scripts/voice-smoke.ts --gateway --documents",
    "test:documents": "node --env-file=.env ./node_modules/vitest/vitest.mjs run apps/api/tests/documents.integration.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "hyparquet": "1.31.3",
    "hyparquet-compressors": "1.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
