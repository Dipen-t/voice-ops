# Local bootstrap/import CLI only. Never pass this file to the runtime API.
# Replace the same placeholder in both password fields. db:setup generates
# evaluator and runtime URLs/passwords without printing them.
POSTGRES_USER=voiceops_dev
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
POSTGRES_DB=voiceops
POSTGRES_PORT=15432
REDIS_PORT=16379
ADMIN_DATABASE_URL=postgresql://voiceops_dev:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@127.0.0.1:15432/voiceops
